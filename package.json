{
  "name": "conversational-bi",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "typecheck": "tsc -p frontend/tsconfig.app.json --noEmit && tsc -p backend/tsconfig.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  }
}
