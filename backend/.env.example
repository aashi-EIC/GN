NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Client-owned semantic-model catalogue and frontend feature configuration.
# Keep identifiers and display values here until a client configuration service is available.
SEMANTIC_MODELS_JSON=[]
FEATURE_FLAGS_JSON={"debugMode":false,"issueReporting":true,"voiceInput":true,"chartDownload":false}
MAX_PROMPT_LENGTH=20000
MAX_HISTORY_ITEMS=10

# Inbound Microsoft Entra token validation (values must come from the client)
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
ENTRA_REQUIRED_SCOPE=
ENTRA_ALLOWED_ROLES=

# Optional Redis. Leave empty to use the process-local rate limiter.
REDIS_URL=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# External MCP host. No endpoint path is assumed.
MCP_BASE_URL=
MCP_ENDPOINT_PATH=
MCP_TIMEOUT_MS=30000
MCP_MAX_RESPONSE_BYTES=5242880
MCP_SAFE_RETRY_ENABLED=false
MCP_MAX_RETRIES=0

# Outbound authentication: api-key for current testing; obo for production.
MCP_AUTH_MODE=api-key
MCP_API_KEY_HEADER=
MCP_API_KEY_VALUE=

# Required only when MCP_AUTH_MODE=obo.
# For one app registration, OBO_CLIENT_ID is the same client id used by React.
# OBO_TENANT_ID can be left blank when it is the same as ENTRA_TENANT_ID.
OBO_TENANT_ID=
OBO_CLIENT_ID=
OBO_CLIENT_SECRET=
OBO_DOWNSTREAM_SCOPE=

# Client-specific external request field names. These are intentionally blank.
MCP_REQUEST_PROMPT_FIELD=
MCP_REQUEST_SESSION_FIELD=
MCP_REQUEST_MODEL_FIELD=
MCP_REQUEST_CORRELATION_FIELD=
MCP_REQUEST_USER_FIELD=
MCP_REQUEST_USER_VALUE_SOURCE=

# Client-specific external response paths, using dot notation.
MCP_RESPONSE_TEXT_PATH=
MCP_RESPONSE_DATA_PATH=
MCP_RESPONSE_DEBUG_PATH=
MCP_RESPONSE_VISUALIZATION_PATH=
