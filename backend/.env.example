# Local development. Use .env.deployment.example for the Kubernetes workload.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Use s3 in the deployed BFF; file keeps local development independent of AWS access.
# Both sources are read once at startup. Restart the BFF to refresh the catalogue.
SEMANTIC_MODEL_GUIDE_SOURCE=file
# File source: empty paths use the paired files in backend/config.
# An external policy also requires an explicit local guide path (no AWS calls in file mode).
SEMANTIC_MODEL_POLICY_PATH=
SEMANTIC_MODEL_GUIDE_PATH=
# S3 source: the SDK obtains source credentials from the workload's AWS identity.
SEMANTIC_MODEL_GUIDE_S3_BUCKET=q-lib
# Load the policy first; its model_guide_s3_path selects the guide object in this bucket.
SEMANTIC_MODEL_POLICY_S3_KEY=CONVERSATIONAL_BI_FRONTEND_JSON_CONFIG/semantic_model_user_policy/semantic_model_user_policy.json
SEMANTIC_MODEL_GUIDE_S3_REGION=us-west-2
SEMANTIC_MODEL_GUIDE_ROLE_ARN=arn:aws:iam::700997598514:role/dev-team-irsa-role-nonprod
SEMANTIC_MODEL_GUIDE_STS_REGION=us-east-1
SEMANTIC_MODEL_GUIDE_TIMEOUT_MS=30000
# Comma-separated IDs excluded from both sources and rejected by chat routes.
SEMANTIC_MODEL_GUIDE_EXCLUDED_IDS=
FEATURE_FLAGS_JSON={"debugMode":false,"issueReporting":true,"voiceInput":true,"chartDownload":false}
MAX_PROMPT_LENGTH=20000
MAX_HISTORY_ITEMS=10
# Per BFF process across both chat endpoints. Resets on restart; calendar months use UTC.
MONTHLY_TOKEN_LIMIT=1000000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Set this to the approved MCP Host origin before starting the BFF.
MCP_BASE_URL=
MCP_ENDPOINT_PATH=/chat
# Keep false until streaming has passed internal rollout testing.
CHAT_STREAMING_ENABLED=false
MCP_STREAM_ENDPOINT_PATH=/chat/stream
# Anonymous pilot metadata only; does not authenticate users.
MCP_STREAM_EMAIL=test@example.com
MCP_TIMEOUT_MS=300000
MCP_MAX_RESPONSE_BYTES=5242880
MCP_SAFE_RETRY_ENABLED=false
MCP_MAX_RETRIES=0

# Use api-key only when the MCP Host requires it; keep the value in .env or a deployment Secret.
MCP_AUTH_MODE=none
MCP_API_KEY_HEADER=
MCP_API_KEY_VALUE=

# Match field names and model IDs to the deployed MCP Host contract.
MCP_REQUEST_PROMPT_FIELD=message
MCP_REQUEST_SESSION_FIELD=session_id
MCP_REQUEST_MODEL_FIELD=semantic_model_id
MCP_REQUEST_STATIC_FIELDS_JSON={}
MCP_MODEL_ID_MAP_JSON={"schedule_completeness_tsg":"tsg","mapping_stats_vod":"mapping_stats","cpx_metrics":"cpxm"}
MCP_REQUEST_CORRELATION_FIELD=
MCP_REQUEST_USER_FIELD=user_id
MCP_REQUEST_USER_VALUE_SOURCE=browser_user_id

# Optional paths for MCP response variants.
MCP_RESPONSE_TEXT_PATH=
MCP_RESPONSE_DATA_PATH=
MCP_RESPONSE_DEBUG_PATH=
MCP_RESPONSE_VISUALIZATION_PATH=
