NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Client-owned semantic-model catalogue and frontend feature configuration.
# Keep identifiers and display values here until a client configuration service is available.
SEMANTIC_MODELS_JSON=[]
FEATURE_FLAGS_JSON={"debugMode":false,"issueReporting":true,"voiceInput":true,"chartDownload":false}
MAX_PROMPT_LENGTH=20000
MAX_HISTORY_ITEMS=10

# Inbound Microsoft Entra token validation (values must come from the client)
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
ENTRA_ACCEPT_V1_TOKENS=false
ENTRA_REQUIRED_SCOPE=
ENTRA_ALLOWED_ROLES=
# Local development only. Never enable this in a shared or production environment.
DISABLE_AUTH=false

# Optional Redis. Leave empty to use the process-local rate limiter.
REDIS_URL=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Client-owned external MCP host.
MCP_BASE_URL=
MCP_ENDPOINT_PATH=/chat
MCP_TIMEOUT_MS=60000
MCP_MAX_RESPONSE_BYTES=5242880
MCP_SAFE_RETRY_ENABLED=false
MCP_MAX_RETRIES=0

# Outbound authentication: none only for the current unprotected demo endpoint;
# use api-key for protected testing and obo for production.
MCP_AUTH_MODE=none
MCP_API_KEY_HEADER=
MCP_API_KEY_VALUE=

# Required only when MCP_AUTH_MODE=obo.
# For one app registration, OBO_CLIENT_ID is the same client id used by React.
# OBO_TENANT_ID can be left blank when it is the same as ENTRA_TENANT_ID.
OBO_TENANT_ID=
OBO_CLIENT_ID=
OBO_CLIENT_SECRET=
OBO_DOWNSTREAM_SCOPE=

# Client-specific external request field names.
MCP_REQUEST_PROMPT_FIELD=message
MCP_REQUEST_SESSION_FIELD=session_id
# Leave blank because the current MCP /chat request does not accept a model field.
MCP_REQUEST_MODEL_FIELD=
MCP_REQUEST_CORRELATION_FIELD=
MCP_REQUEST_USER_FIELD=
MCP_REQUEST_USER_VALUE_SOURCE=

# The response adapter accepts both answer.text/answer.blocks and the current
# user_input/llm_output/tool_result MCP response envelope.
