NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173

# MCP endpoint
MCP_BASE_URL=http://gnbia-mcp-host.k8s-np.cloud.gracenote.com
MCP_ENDPOINT_PATH=/chat
MCP_TIMEOUT_MS=300000
MCP_MAX_RESPONSE_BYTES=5242880
MCP_SAFE_RETRY_ENABLED=false
MCP_MAX_RETRIES=0

# MCP authentication is carried in the request payload for this integration.
MCP_AUTH_MODE=none
MCP_API_KEY_HEADER=
MCP_API_KEY_VALUE=

# MCP request contract
MCP_REQUEST_PROMPT_FIELD=message
MCP_REQUEST_SESSION_FIELD=
MCP_REQUEST_MODEL_FIELD=semantic_model_id
MCP_REQUEST_STATIC_FIELDS_JSON={"user_id":"admin","email":"admin@admin.com","bearer_token":"replace-with-secret"}
MCP_MODEL_ID_MAP_JSON={"schedule_completeness_tsg":"tsg"}
MCP_REQUEST_CORRELATION_FIELD=
MCP_REQUEST_USER_FIELD=
MCP_REQUEST_USER_VALUE_SOURCE=

# Optional response paths. Leave blank to use automatic response detection.
MCP_RESPONSE_TEXT_PATH=
MCP_RESPONSE_DATA_PATH=
MCP_RESPONSE_DEBUG_PATH=
MCP_RESPONSE_VISUALIZATION_PATH=

# Optional persistence and rate limiting
DATABASE_URL=
DATABASE_SSL=false
REDIS_URL=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
