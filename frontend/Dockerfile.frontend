FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/package.json
COPY backend/package.json ./backend/package.json
RUN npm ci --workspace frontend --include-workspace-root=false --no-audit --no-fund

COPY frontend/ ./frontend/

ARG VITE_API_BASE_URL
ARG VITE_API_TIMEOUT_MS=315000

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_API_TIMEOUT_MS=$VITE_API_TIMEOUT_MS

RUN npm run build --workspace frontend

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

COPY frontend/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --chown=101:101 frontend/runtime-config.js.template /etc/conversational-bi/runtime-config.js.template
COPY --chmod=755 frontend/docker-entrypoint.d/40-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh
COPY --from=build --chown=101:101 /app/frontend/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --spider http://127.0.0.1:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
