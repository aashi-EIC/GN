VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_API_TIMEOUT_MS=315000
# Opt in only on streaming test deployments. The BFF must also enable streaming.
VITE_CHAT_STREAMING_ENABLED=false

# Microsoft Entra ID Authentication
VITE_ENTRA_ENABLED=false
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=common
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
# Required for On-Behalf-Of (OBO) flow: Scope exposed by the BFF API (e.g. api://<client-id>/access_as_user)
VITE_ENTRA_API_SCOPE=api://<client-id>/access_as_user
VITE_ENTRA_SCOPES=User.Read
